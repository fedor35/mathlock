<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>

    <application android:label="ReadBench" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:extractNativeLibs="true"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <!-- QNN HTP грузит libcdsprpc.so из /vendor -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false"/>
        <activity android:name=".ReadActivity" android:exported="true" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".BenchActivity" android:exported="true"/>
        <activity android:name=".ParentActivity" android:exported="false" android:screenOrientation="portrait"/>
        <activity android:name=".CompeteActivity" android:exported="true" android:screenOrientation="portrait"/>
        <activity android:name=".DuelActivity" android:exported="true" android:screenOrientation="portrait"/>
        <activity android:name=".RecordsActivity" android:exported="true" android:screenOrientation="portrait"/>
        <activity android:name=".AwardsActivity" android:exported="true" android:screenOrientation="portrait"/>
    </application>
</manifest>
